# W5CDN Net Logger Configuration
# Copy this file to .env (or config.txt) and fill in your credentials as needed.
# (You can also configure all of these inside the app under Preferences.)

# Default Net Control Station (NCS) operator callsign
OPERATOR_CALL=W5CDN

# Optional QRZ.com XML Logbook Data credentials
# If left blank (or if QRZ lookup fails), lookups automatically fall back to Callook.info
QRZ_USER=
QRZ_PASS=

# Optional LinBPQ / BPQ32 Telnet password override (can also be saved in Preferences)
# BPQ_PASS=

# Optional data directory, SQLite database & NTS radiogram folder overrides
# NET_LOGGER_DATA_DIR=
# NET_LOGGER_DB=net_logger.db
# RADIOGRAMS_DIR=radiograms
