{
  "name": "w5cdn-nts-traffic",
  "version": "0.1.0",
  "description": "Standalone ARRL NTS Radiogram & Traffic Manager desktop app (Electron + TypeScript + SQLite)",
  "main": "dist/main/main.js",
  "scripts": {
    "ensure-electron": "node scripts/ensure-electron.mjs",
    "build": "tsc -p tsconfig.json && node scripts/copy-renderer.mjs",
    "start": "npm run ensure-electron && npm run build && electron .",
    "dev": "npm run ensure-electron && npm run build && electron .",
    "smoke": "npm run ensure-electron && npm run build && node scripts/run-smoke.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "package:win": "npm run build && electron-builder --win nsis",
    "package:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/sql.js": "^1.4.9",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "build": {
    "appId": "org.w5cdn.nts-traffic",
    "productName": "W5CDN NTS Traffic Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  },
  "allowScripts": {
    "electron@35.7.5": true,
    "esbuild@0.28.2": true
  }
}
