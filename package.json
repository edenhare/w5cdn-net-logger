{
  "name": "w5cdn-net-logger",
  "version": "0.2.1",
  "description": "Local Ham Radio Net Control Logger (Electron + TypeScript + SQLite)",
  "author": "W5CDN / Eden Hare",
  "main": "dist/main/main.js",
  "scripts": {
    "prepare": "husky",
    "ensure-electron": "node scripts/ensure-electron.mjs",
    "build": "tsc -p tsconfig.json && node scripts/copy-static.mjs",
    "start": "npm run ensure-electron && npm run build && electron .",
    "dev": "npm run ensure-electron && npm run build && electron .",
    "smoke": "npm run ensure-electron && npm run build && node scripts/run-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "npm run build && node tests/e2e/ui_e2e.mjs",
    "version:check": "node scripts/bump-version.mjs --check",
    "package:dir": "npm run build && electron-builder --dir -c.win.signAndEditExecutable=false",
    "package:win": "npm run build && electron-builder --win nsis",
    "package:linux": "npm run build && electron-builder --linux AppImage"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/sql.js": "^1.4.9",
    "@vitest/coverage-v8": "^5.1.1",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "husky": "^9.1.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "build": {
    "appId": "org.w5cdn.net-logger",
    "productName": "W5CDN Net Logger",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "src/static/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "menuCategory": "W5CDN",
      "include": "build/installer.nsh"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  },
  "allowScripts": {
    "electron@35.7.5": true,
    "esbuild@0.28.2": true
  }
}
